---
import WeekLayout from '../layouts/WeekLayout.astro';
import { PUBLISHED_WEEKS } from '../config/routes';
if (!PUBLISHED_WEEKS.includes(4)) return Astro.redirect('/');
---

<WeekLayout
  week={4}
  title="04"
  subtitle="Calm after the noise"
  dates="8 — 14 JUN"
  primaryColor="#FFD700"
  accentColor="#FF6B35"
  bgColor="#fffbf0"
  prevSlug="week-03"
  prevTitle="Week 03"
  nextSlug="week-05"
  nextTitle="Week 05"
  modelPath="skip"
  glassContent={true}
>


  <!-- ── BATTERY ── -->
  <section class="content-section battery-section">
    <p class="battery-label">RECHARGING ENERGY</p>
    <h2 class="battery-heading">Week 3 drained it.<br/>Week 4 fixed it.</h2>
    <div class="battery-layout">
      <div class="battery-wrap" id="batteryWrap">
        <div class="battery-body">
          <div class="battery-fill" id="batteryFill"></div>
          <div class="battery-cells" aria-hidden="true"></div>
          <span class="battery-bolt">⚡</span>
          <span class="battery-pct" id="batteryPct">0%</span>
        </div>
        <div class="battery-terminal"></div>
      </div>
      <div class="battery-caption">
        <p class="bat-line" data-at="25">São Gonçalo survived</p>
        <p class="bat-line" data-at="55">Three days of parties</p>
        <p class="bat-line" data-at="90">Recharging via river</p>
        <p class="bat-line" data-at="95">Ready for next week</p>
      </div>
    </div>
  </section>

  <!-- ── TÂMEGA ── -->
  <section class="content-section tamega-section">
    <h2 class="tamega-title">A week to<br/>recharge energy.</h2>
    <div class="tamega-body">
      <p>
        This week was about slowing down. After the noise and excitement of the festa, we needed to find a quiet corner of Amarante to rest and recharge.
      </p>
      <p>
        The Tâmega river, which runs through the city, became our main spot. We spent hours sitting by its banks, watching the water flow and feeling the cool breeze on our faces. Since the temperatures are rising again, the river was the perfect place to escape the heat. 
      </p>
      <p>
        On this week, we made a lot of night activities with the people of the CJ, activities organised by them, for them. We made some introduction activities for the newcomers, ping-pong tournaments, football matches, and some more activities that we can't even remember.
      </p>
      <p>
        This place after the festa, became a really quiet city. The streets that were full of music and people, are now calm and empty. It's a completely different vibe, but we also love it. How a city can be so different in just a few days.
      </p>
      <p>
        Week 3 had us dancing and celebrating until late, week 4 had us sitting by the river, talking and laughing until late. Both were amazing, but in very different ways.
      </p>
      <p>
        For more photos of this week, check out the <a href="/gallery">gallery</a>!
      </p>
    </div>
  </section>

  <!-- ── VIBES ── -->
  <section class="content-section vibes-section">
    <span class="section-tag">The vibe</span>
    <div class="vibe-cards">
      <div class="vibe-card" style="--rot:2deg;--delay:0.15s;">
        <span class="vibe-icon">🏊</span>
        <h3 class="vibe-title">The river</h3>
        <p class="vibe-text">Cold water, warm rock, zero agenda. The Tâmega had absolutely no notes.</p>
      </div>
      <div class="vibe-card" style="--rot:-1.5deg;--delay:0.3s;">
        <span class="vibe-icon">🌅</span>
        <h3 class="vibe-title">Golden hour</h3>
        <p class="vibe-text">The kind of evenings that make you forget you own a phone.</p>
      </div>
      <div class="vibe-card" style="--rot:2.5deg;--delay:0.45s;">
        <span class="vibe-icon">🌙</span>
        <h3 class="vibe-title">Until late</h3>
        <p class="vibe-text">Sitting by the river, talking and laughing. No rush, no phones just good company and the sound of water.</p>
      </div>
    </div>
  </section>


  <!-- ── PHOTOS ── -->
  <section class="content-section">
    <span class="section-tag">Photos</span>
    <h2>The week in images</h2>
    <div class="photo-grid">
      <div class="photo-item" style="--tilt:-2deg;"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week4/week04-01.webp" loading="lazy" decoding="async" alt="Photo 1"></div>
      <div class="photo-item" style="--tilt:1.5deg;"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week4/week04-02.webp" loading="lazy" decoding="async" alt="Photo 2"></div>
      <div class="photo-item" style="--tilt:-1deg;"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week4/week04-03.webp" loading="lazy" decoding="async" alt="Photo 3"></div>
      <div class="photo-item" style="--tilt:2deg;"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week4/week04-04.webp" loading="lazy" decoding="async" alt="Photo 4"></div>
      <div class="photo-item" style="--tilt:-1.5deg;"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week4/week04-05.webp" loading="lazy" decoding="async" alt="Photo 5"></div>
      <div class="photo-item" style="--tilt:1deg;"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week4/week04-06.webp" loading="lazy" decoding="async" alt="Photo 6"></div>
    </div>
  </section>

  <script>
    import '../scripts/three-week-04.ts';

    // Battery charge animation
    const fill = document.getElementById('batteryFill');
    const pct  = document.getElementById('batteryPct');
    const wrap = document.getElementById('batteryWrap');
    const lines = Array.from(document.querySelectorAll<HTMLElement>('.bat-line'));
    if (fill && pct && wrap) {
      const paint = (v: number) => {
        fill.style.width = v + '%';
        pct.textContent = v + '%';
        // colour: orange below 40, gold above
        fill.style.background = v < 40
          ? `linear-gradient(90deg, #FF6B35, #ffaa55)`
          : `linear-gradient(90deg, #FFD700, #ffe680)`;
        // checklist syncs with charge level: done when passed, next one blinks
        let activeFound = false;
        for (const line of lines) {
          const done = v >= Number(line.dataset.at);
          line.classList.toggle('bat-line--done', done);
          line.classList.toggle('bat-line--active', !done && !activeFound);
          if (!done) activeFound = true;
        }
      };
      const obs = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        obs.disconnect();
        let v = 8;
        const target = 94;
        const step = () => {
          v = Math.min(v + 1, target);
          paint(v);
          if (v < target) setTimeout(step, 26);
          else wrap.classList.add('charged');
        };
        step();
      }, { threshold: 0.4 });
      obs.observe(fill);
    }
  </script>

  <style is:global>
    .hero-subtitle, .hero-dates, .scroll-hint {
      color: #ffffff;
      text-shadow: 0 2px 10px rgba(80,40,0,0.65), 0 1px 3px rgba(80,40,0,0.85);
    }
  </style>

  <style>
    /* ── ZEN INTRO ── */
    .zen-intro { text-align: center; padding: 4.5rem 2.5rem !important; }
    .zen-title {
      font-size: clamp(2rem,5vw,4rem); font-weight: 900;
      line-height: 0.95; letter-spacing: -0.02em; margin: 0;
      text-transform: uppercase; color: #2a1200;
    }
    .zen-sun {
      width: 14px; height: 14px; border-radius: 50%;
      background: #FFD700; margin: 1.6rem auto;
      box-shadow: 0 0 18px 5px rgba(255,200,60,0.7);
      animation: sun-breathe 3.5s ease-in-out infinite;
    }
    @keyframes sun-breathe {
      0%,100% { transform: scale(1);    box-shadow: 0 0 14px 4px rgba(255,200,60,0.55); }
      50%      { transform: scale(1.25); box-shadow: 0 0 26px 8px rgba(255,200,60,0.85); }
    }
    .zen-meta {
      font-family: var(--font-mono); font-size: 0.68rem;
      letter-spacing: 0.28em; text-transform: uppercase; color: rgba(60,30,0,0.65); margin:0;
    }

    /* ── BATTERY ── */
    .battery-section {
      padding: 3rem 2.5rem !important;
      text-align: center;
      display: flex; flex-direction: column; align-items: center;
    }
    .battery-label {
      font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.3em;
      color: rgba(60,30,0,0.65); text-transform: uppercase; margin: 0 0 1rem;
    }
    .battery-heading {
      font-size: clamp(2rem,5vw,4rem); font-weight: 900;
      line-height: 0.95; color: #2a1200; margin: 0 0 2.5rem;
      text-transform: uppercase; letter-spacing: -0.02em;
    }
    .battery-layout {
      display: flex; flex-direction: column; gap: 2.2rem; align-items: center;
    }
    .battery-wrap { display: flex; align-items: center; width: 100%; max-width: 560px; }
    .battery-terminal {
      width: 10px; height: 34px; flex-shrink: 0;
      background: rgba(100,60,0,0.25); border-radius: 0 4px 4px 0;
    }
    .battery-body {
      flex: 1; height: 92px;
      border: 3px solid rgba(100,60,0,0.35); border-radius: 10px;
      position: relative; overflow: hidden;
      background: rgba(255,255,255,0.3);
      transition: box-shadow 0.6s, border-color 0.6s;
    }
    .battery-fill {
      position: absolute; top: 0; bottom: 0; left: 0;
      width: 0%; transition: background 0.4s;
      box-shadow: 0 0 18px rgba(255,215,0,0.5);
    }
    .battery-fill::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,0.4) 50%, transparent 70%);
      animation: charge-sheen 1.6s ease-in-out infinite;
    }
    @keyframes charge-sheen {
      from { transform: translateX(-100%); }
      to   { transform: translateX(100%); }
    }
    .battery-cells {
      position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background: repeating-linear-gradient(90deg,
        transparent 0, transparent calc(10% - 2px),
        rgba(100,60,0,0.14) calc(10% - 2px), rgba(100,60,0,0.14) 10%);
    }
    .battery-bolt {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.2rem; z-index: 2;
      animation: bolt-pulse 1.2s ease-in-out infinite;
      filter: drop-shadow(0 0 6px rgba(255,215,0,0.8));
    }
    @keyframes bolt-pulse {
      0%,100% { opacity: 0.8; transform: scale(1); }
      50%      { opacity: 1;   transform: scale(1.15); }
    }
    .battery-pct {
      position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      font-family: var(--font-mono); font-size: 1rem;
      font-weight: 700; color: #2a1200; z-index: 2; letter-spacing: 0.05em;
    }
    .battery-wrap.charged .battery-body {
      border-color: rgba(255,170,0,0.6);
      animation: charged-glow 2s ease-in-out infinite;
    }
    .battery-wrap.charged .battery-fill::after { animation: none; opacity: 0; }
    @keyframes charged-glow {
      0%,100% { box-shadow: 0 0 14px rgba(255,215,0,0.35); }
      50%      { box-shadow: 0 0 32px rgba(255,215,0,0.65); }
    }
    .battery-caption {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 2rem; max-width: 560px; justify-items: center;
    }
    @media (max-width: 580px) {
      .battery-caption { grid-template-columns: 1fr; }
    }
    .bat-line {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.04em; margin: 0; line-height: 1;
      color: rgba(60,30,0,0.45);
      transition: color 0.3s;
    }
    .bat-line--done { color: rgba(60,30,0,0.55); text-decoration: line-through; }
    .bat-line--done::after { content: ' ✓'; }
    .bat-line--active {
      color: #c85000; font-weight: 700;
    }
    .bat-line--active::after { content: ' ▋'; animation: blink-dot 1s step-end infinite; }
    @keyframes blink-dot { 0%,100% { opacity:1; } 50% { opacity:0; } }

    /* ── TÂMEGA ── */
    .tamega-section { padding: 3.5rem 2.5rem !important; overflow: hidden; }
    .tamega-title {
      font-size: clamp(2rem,5vw,4rem); font-weight: 900;
      line-height: 0.95; color: #2a1200; margin: 1rem 0 2rem;
      text-transform: uppercase; letter-spacing: -0.02em;
    }
    .tamega-body p {
      font-size: 1.1rem; line-height: 1.75;
      opacity: 0.65; margin-bottom: 1.1rem; font-weight: 400;
    }
    .tamega-closer {
      font-size: clamp(1.1rem,2.5vw,1.35rem) !important;
      font-weight: 600 !important; color: #2a1200 !important;
      letter-spacing: -0.01em; margin-top: 1.8rem !important;
    }

    /* ── VIBES ── */
    .vibes-section { padding: 3rem 2.5rem !important; }
    .vibe-cards {
      display: grid; grid-template-columns: repeat(3,1fr);
      gap: 1.2rem; margin-top: 1.5rem;
    }
    @media (max-width: 580px) {
      .vibe-cards { grid-template-columns: 1fr; }
    }
    .vibe-card {
      background: rgba(255,250,235,0.9);
      border: 1px solid rgba(255,215,0,0.3);
      border-radius: 1.2rem; padding: 1.8rem 1.4rem;
      transform: rotate(var(--rot,0deg));
      transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s;
      box-shadow: 0 4px 20px rgba(120,70,0,0.1);
      cursor: default;
      position: relative; overflow: hidden;
    }
    .vibe-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, #FFD700, #FF6B35);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.35s ease;
    }
    .vibe-card:hover {
      transform: rotate(0deg) translateY(-4px);
      box-shadow: 0 12px 32px rgba(120,70,0,0.18);
    }
    .vibe-card:hover::before { transform: scaleX(1); }
    .vibe-icon {
      font-size: 2.2rem; display: block; margin-bottom: 0.9rem;
      animation: icon-bob 3.2s ease-in-out var(--delay,0s) infinite;
    }
    @keyframes icon-bob {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-5px); }
    }
    .vibe-title {
      font-size: 1.1rem; font-weight: 600; color: #2a1200;
      margin: 0 0 0.6rem; letter-spacing: -0.01em;
    }
    .vibe-text {
      font-size: 0.88rem; line-height: 1.65; color: rgba(60,30,0,0.82); margin: 0;
    }

    /* ── PHOTOS — scattered polaroid tilt ── */
    .photo-item {
      transform: rotate(var(--tilt, 0deg));
      transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s;
    }
    .photo-item:hover {
      transform: rotate(0deg) scale(1.04);
      box-shadow: 0 14px 36px rgba(120,70,0,0.25);
      z-index: 3;
    }
  </style>
</WeekLayout>
