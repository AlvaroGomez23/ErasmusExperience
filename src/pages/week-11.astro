---
import WeekLayout from '../layouts/WeekLayout.astro';
import { PUBLISHED_WEEKS } from '../config/routes';
import { weeks } from '../data/weeks';
if (!PUBLISHED_WEEKS.includes(11)) return Astro.redirect('/');

// Reverse recap — every prior week, linked when its page is live.
const recap = weeks.filter((w) => w.week < 11);

// The 3D hero each week represents — its GLB model, or a wireframe geometry
// (weeks 8–10, which have no GLB). Rendered small inside each recap card.
const heroModel: Record<number, { model?: string; geo?: string }> = {
  1:  { model: '/models/Airplane.glb' },
  2:  { model: '/models/Sun.glb' },
  3:  { model: '/models/Star.glb' },
  4:  { model: '/models/Bird.glb' },
  5:  { model: '/models/Star.glb' },
  6:  { model: '/models/bridge.glb' },
  7:  { model: '/models/Car.glb' },
  8:  { model: '/models/arrivals2.glb' },
  9:  { model: '/models/worldcup.glb' },
  10: { model: '/models/Barrel.glb' },
};

// Supabase config for the 3D memory cloud (same bucket the gallery uses).
const supabaseConfig = JSON.stringify({
  url: import.meta.env.SUPABASE_URL,
  key: import.meta.env.SUPABASE_KEY,
});

// Big sign-off, split into characters so each letter can animate in.
const SIGNOFF = 'OBRIGADO AMARANTE';

// Boarding pass — the leaving ticket. Edit before departure.
const pass = {
  airline:   'ERASMUS AIRLINES',
  fromCode:  'OPO',   fromCity: 'Oporto',
  toCode:    'BCN',   toCity:   'Barcelona',
  passenger: 'JOSE & ÁLVARO',
  flight:    'VY8481',
  date:      '31 JUL',
  gate:      '--',
  seat:      '15F',
  boarding:  '22:00',
  seq:       '0011',
};
// Random-width bars for the barcode (widths in px, 1–3).
const barcode = Array.from({ length: 30 }, () => 1 + Math.floor(Math.random() * 3));

// Departure board — one split-flap row per week, plus the real flight out.
const boardRows = [
  ...weeks.map((w) => ({
    flight: `AM${String(w.week).padStart(2, '0')}`,
    dest: w.subtitle.toUpperCase(),
    status: w.week < 11 ? 'DEPARTED' : 'BOARDING',
    kind: w.week < 11 ? 'ok' : 'now',
    final: false,
  })),
  { flight: pass.flight, dest: pass.toCity.toUpperCase(), status: 'FINAL CALL', kind: 'call', final: true },
];

---

<WeekLayout
  week={11}
  title="11"
  subtitle="Last days, eternal memories"
  dates="27 - 31 JUL"
  primaryColor="#2196F3"
  accentColor="#00BCD4"
  bgColor="#f0f7ff"
  prevSlug="week-10"
  prevTitle="Week 10"
  nextSlug={null}
  nextTitle={null}
  modelPath="/models/Airplane.glb"
  glassContent
>
  <!-- ─── SUNSET SKY — day → dusk → starry night as you scroll to The End ─── -->
  <div id="sky" aria-hidden="true">
    <div class="sky-layer sky-sunset"></div>
    <div class="sky-layer sky-night">
      <div class="sky-stars sky-stars--a"></div>
      <div class="sky-stars sky-stars--b"></div>
      <div class="sky-moon"></div>
    </div>
  </div>

  <section class="content-section">
    <span class="section-tag">Farewell</span>
    <h2>All things end</h2>
    <p>
      I guess every experience eventually comes to an end, and this is the end of our two-and-a-half-month adventure. A journey that has changed us, shaped us, and left a mark on our lives that we'll carry forever.
    </p>
    <p>
      Bags packed, endless goodbyes, and that strange feeling of leaving a place that somehow became home without us even realizing it.
    </p>
    <p>
      Eleven weeks in Amarante. Eleven weeks of new friendships, unforgettable memories, laughter, challenges, and moments we'll remember for the rest of our lives.
    </p>
  </section>

  <!-- ─── REVERSE RECAP WALL — each tile shows that week's 3D hero ─── -->
  <section class="content-section">
    <span class="section-tag">The whole journey</span>
    <h2>Ten weeks, one story</h2>
    <div class="recap-wall">
      {recap.map((w) => {
        const live = PUBLISHED_WEEKS.includes(w.week);
        const Tag = live ? 'a' : 'div';
        return (
          <Tag
            href={live ? `/${w.slug}` : undefined}
            class={`recap-tile${live ? '' : ' is-locked'}${w.week === 9 ? ' recap-tile--rainbow' : ''}`}
            style={`--tile: ${w.primaryColor};`}
          >
            <canvas
              class="recap-canvas"
              data-color={w.primaryColor}
              data-model={heroModel[w.week]?.model}
              data-geo={heroModel[w.week]?.geo}
              aria-hidden="true"
            ></canvas>
            <span class="recap-num">{String(w.week).padStart(2, '0')}</span>
            <span class="recap-sub">{w.subtitle}</span>
          </Tag>
        );
      })}
    </div>
  </section>

  <!-- ─── DEPARTURE BOARD — split-flap rows, one per week ─── -->
  <section class="content-section">
    <span class="section-tag">Now departing</span>
    <h2>Departures</h2>
    <div class="dep-board" id="dep-board" aria-label="Departures board">
      <div class="dep-head" aria-hidden="true">
        <span>Flight</span><span>Destination</span><span>Status</span>
      </div>
      {boardRows.map((r) => (
        <div class={`dep-row${r.final ? ' dep-row--final' : ''}`}>
          <span class="dep-cell dep-flight">{r.flight}</span>
          <span class="dep-cell dep-dest">{r.dest}</span>
          <span class={`dep-cell dep-status dep-status--${r.kind}`}>{r.status}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── BOARDING PASS — the leaving ticket (3D-tilt on hover) ─── -->
  <section class="content-section">
    <span class="section-tag">One way</span>
    <h2>Boarding pass</h2>
    <div class="pass-stage">
      <article class="pass" id="boarding-pass"
               aria-label={`Boarding pass, ${pass.fromCity} to ${pass.toCity}, passengers ${pass.passenger}`}>
        <div class="pass-main">
          <header class="pass-air">
            <span class="pass-air-name">{pass.airline}</span>
            <span class="pass-air-mark" aria-hidden="true">✈</span>
          </header>

          <div class="pass-route">
            <div class="pass-city">
              <span class="pass-code">{pass.fromCode}</span>
              <span class="pass-city-name">{pass.fromCity}</span>
            </div>
            <div class="pass-fly" aria-hidden="true">
              <span class="pass-fly-line"></span>
              <span class="pass-fly-plane">✈</span>
            </div>
            <div class="pass-city pass-city--to">
              <span class="pass-code">{pass.toCode}</span>
              <span class="pass-city-name">{pass.toCity}</span>
            </div>
          </div>

          <dl class="pass-grid">
            <div><dt>Passenger</dt><dd>{pass.passenger}</dd></div>
            <div><dt>Flight</dt><dd>{pass.flight}</dd></div>
            <div><dt>Date</dt><dd>{pass.date}</dd></div>
            <div><dt>Gate</dt><dd>{pass.gate}</dd></div>
            <div><dt>Seat</dt><dd>{pass.seat}</dd></div>
            <div><dt>Boarding</dt><dd>{pass.boarding}</dd></div>
          </dl>
        </div>

        <aside class="pass-stub">
          <span class="pass-stub-tag">Boarding pass</span>
          <span class="pass-stub-route">{pass.fromCode} → {pass.toCode}</span>
          <span class="pass-stub-name">{pass.passenger}</span>
          <div class="pass-mini">
            <span class="pass-mini-cell"><small>Seat</small><strong>{pass.seat}</strong></span>
            <span class="pass-mini-cell"><small>Gate</small><strong>{pass.gate}</strong></span>
          </div>
          <div class="pass-barcode" aria-hidden="true">
            {barcode.map((w) => <i style={`width:${w}px`}></i>)}
          </div>
          <span class="pass-seq">{pass.flight} · {pass.seq}</span>
        </aside>

        <div class="pass-glare" aria-hidden="true"></div>
        <span class="pass-notch pass-notch--top" aria-hidden="true"></span>
        <span class="pass-notch pass-notch--bottom" aria-hidden="true"></span>
      </article>
    </div>
  </section>

  <!-- ─── TWO-PERSON LETTER ─── -->
  <section class="content-section">
    <span class="section-tag">To Amarante</span>
    <h2>Two goodbyes</h2>
    <div class="letter-grid">
      <div class="letter">
        <span class="letter-from">Jose</span>

<p>
  Looking back on this Erasmus+ experience, I realize that what made it truly unforgettable were the people I had the chance to meet and live with. Some stayed from the very beginning, while others came into our lives only for a short time before moving on. No matter how long they were part of this journey, every single person left a mark and helped create memories that I will always remember.
</p>

<br>

<p>
  Every moment we shared became part of an incredible adventure. From spontaneous trips and everyday conversations to endless nights out filled with laughter, music, and unforgettable stories, each experience brought us closer together. These are the moments that turned strangers into friends and made this journey so much more than I ever expected.
</p>

<br>

<p>
  I would also like to express my sincere gratitude to my internship company for welcoming me and giving me the opportunity to learn, grow, and gain valuable experience. A special thank you goes to our Erasmus+ coordinators, Montse and Silvia, whose dedication, support, and hard work made this incredible opportunity possible. Without them, this journey would not have been the same.
</p>

<br>

<p>
  Erasmus+ has been one of the most rewarding experiences of my life. It has taught me to grow, adapt, and appreciate the value of meeting people from different cultures. I truly hope that everyone gets the opportunity to live an experience like this at least once in their life. Thank you all for making these months unforgettable. ❤️
</p>


      </div>
      <div class="letter">
        <span class="letter-from">Álvaro</span>
        <p>
          This experience is something I will never forget. During this time, we met incredible people, each with their own story, culture, and way of seeing the world. Some of them will remain part of our lives, while others we may never see again. Even so, every single one of them has left a mark and made this experience far more special than I ever imagined.
        </p>
        <br>
        <p>
          If there's one thing I can honestly say, it's that I've truly enjoyed this experience with the vast majority of you. Thank you for every trip, every party, every conversation, every meal we shared, every laugh, and every moment we supported each other. These are memories I will carry with me forever.
        </p>
        <br>
        <p>
          Now it's time to say goodbye. I'm grateful that we've shared something truly unique. Erasmus is about much more than studying in another country, it's about growing as a person, stepping outside your comfort zone, and discovering that people from completely different places can make you feel at home.
        </p>
        <br>
        <p>
          I hope all of you achieve everything you dream of, and that even if our paths go in different directions, we'll meet again somewhere in the world. Thank you for being part of this adventure and for making these months unforgettable.
        </p>
        <p>
          Also I would like to thank João and Joana for having us in their company and for giving us the opportunity to learn and grow. And of course, a special thanks to Montse and Silvia for their dedication and support throughout this journey.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 3D MEMORY CLOUD ─── -->
  <section class="content-section content-section--wide">
    <span class="section-tag">Every moment</span>
    <h2>This is our journey</h2>
    <p>
      Photos from all eleven weeks, drifting in space. Move your mouse to
      look around, scroll to fly through them.
    </p>
  </section>
  <section id="memory-cloud" aria-label="Photo memory cloud">
    <canvas id="memory-canvas" aria-hidden="true"></canvas>
    <svg class="the-end" viewBox="0 0 600 220" aria-label="The End">
      <text x="300" y="140" text-anchor="middle">The End</text>
    </svg>
  </section>



  <!-- Supabase config, read by the memory-cloud script. -->
  <script id="sb-config" type="application/json" set:html={supabaseConfig}></script>

  <script>
    import '../scripts/three-week-11.ts';
  </script>
  <script>
    import '../scripts/three-week-11-cloud.ts';
  </script>
  <script>
    import '../scripts/week-11-finale.ts';
  </script>
  <script>
    import '../scripts/week-11-boardingpass.ts';
  </script>
  <script>
    import '../scripts/three-recap-cards.ts';
  </script>
  <script>
    import '../scripts/week-11-departures.ts';
  </script>
  <script>
    import '../scripts/week-11-sky.ts';
  </script>

  <style>
    /* ─── Boarding pass ─── */
    .pass-stage {
      margin-top: 1.6rem;
      perspective: 1200px;
      display: flex; justify-content: center;
    }
    .pass {
      --ink: #12233b;
      --stub: 152px;         /* stub width — the seam sits here */
      position: relative;
      display: flex;
      width: min(680px, 100%);
      min-height: 236px;
      border-radius: 18px;
      background: #fff;
      border: 1.5px solid color-mix(in srgb, var(--week-primary) 40%, #cdd7e6);
      color: var(--ink);
      box-shadow: 0 30px 60px -26px rgba(10, 30, 60, 0.65);
      overflow: hidden;   /* clips the outer half of the notch discs → bites */
      transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.6s ease;
      /* Entrance state — flips up into place when scrolled in. */
      opacity: 0; transform: translateY(28px) rotateX(26deg);
      will-change: transform;
    }
    .pass.is-in { opacity: 1; transform: none; }

    /* Holographic sheen sweeping across the whole ticket, forever. */
    .pass::after {
      content: ''; position: absolute; inset: 0; z-index: 5;
      pointer-events: none; border-radius: inherit;
      background: linear-gradient(115deg,
        transparent 34%,
        color-mix(in srgb, var(--week-accent) 30%, transparent) 46%,
        color-mix(in srgb, var(--week-primary) 30%, transparent) 54%,
        transparent 66%);
      background-size: 260% 100%;
      animation: passSheen 6.5s linear infinite;
      opacity: 0.55;
    }
    @keyframes passSheen {
      0%   { background-position: 140% 0; }
      100% { background-position: -140% 0; }
    }
    /* Pointer-tracked glare highlight. */
    .pass-glare {
      position: absolute; inset: 0; z-index: 6;
      pointer-events: none; border-radius: inherit;
      background: radial-gradient(circle at var(--mx, 50%) var(--my, 0%),
        rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 42%);
      mix-blend-mode: screen;
      opacity: 0; transition: opacity 0.3s ease;
    }
    .pass:hover .pass-glare { opacity: 1; }

    /* Punched notches at the ends of the tear seam. Full discs centred on the
       seam; .pass's overflow:hidden clips the outer half, leaving an outlined
       bite. Same border as the ticket so the outline is continuous. */
    .pass-notch {
      position: absolute; z-index: 7;
      left: calc(100% - var(--stub));
      width: 22px; height: 22px; border-radius: 50%;
      transform: translateX(-50%);
      background: var(--week-bg);
      border: 1.5px solid color-mix(in srgb, var(--week-primary) 40%, #cdd7e6);
    }
    .pass-notch--top { top: -12px; }
    .pass-notch--bottom { bottom: -12px; }

    /* ── Main body ── */
    .pass-main {
      flex: 1; min-width: 0; z-index: 2;
      padding: 1.3rem 1.4rem;
      display: flex; flex-direction: column; gap: 1rem;
    }
    .pass-air {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid rgba(18, 35, 59, 0.12);
      padding-bottom: 0.7rem;
    }
    .pass-air-name {
      font-family: var(--font-mono); font-weight: 700;
      letter-spacing: 0.14em; font-size: 0.78rem;
      color: var(--week-primary);
    }
    .pass-air-mark { font-size: 1.05rem; }

    .pass-route { display: flex; align-items: center; gap: 0.8rem; }
    .pass-city { display: flex; flex-direction: column; }
    .pass-city--to { text-align: right; align-items: flex-end; }
    .pass-code {
      font-size: clamp(1.9rem, 7vw, 2.5rem); font-weight: 800;
      line-height: 1; letter-spacing: -0.02em;
    }
    .pass-city-name {
      font-family: var(--font-mono); font-size: 0.6rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(18, 35, 59, 0.55); margin-top: 0.3rem;
    }
    .pass-fly { flex: 1; position: relative; height: 2px; }
    .pass-fly-line { position: absolute; inset: 0; border-top: 2px dashed rgba(18, 35, 59, 0.3); }
    .pass-fly-plane {
      position: absolute; top: 50%; left: 0;
      transform: translate(-50%, -50%); font-size: 0.95rem;
      color: var(--week-primary);
      animation: flyAcross 5s ease-in-out infinite;
    }
    @keyframes flyAcross { 0%, 100% { left: 0; } 50% { left: 100%; } }

    .pass-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0.7rem 1rem; margin: 0;
    }
    .pass-grid div { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
    .pass-grid dt {
      font-family: var(--font-mono); font-size: 0.55rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(18, 35, 59, 0.5);
    }
    .pass-grid dd {
      margin: 0; font-weight: 700; font-size: 0.92rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* ── Tear-off stub ── */
    .pass-stub {
      flex: 0 0 var(--stub); width: var(--stub); z-index: 2;
      padding: 1.3rem 0.9rem;
      display: flex; flex-direction: column; align-items: center;
      text-align: center; gap: 0.5rem;
      border-left: 2px dashed rgba(18, 35, 59, 0.28);
      background: color-mix(in srgb, var(--week-primary) 6%, #fff);
    }
    .pass-stub-tag {
      font-family: var(--font-mono); font-size: 0.52rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--week-primary);
    }
    .pass-stub-route { font-weight: 800; font-size: 1.05rem; letter-spacing: 0.02em; }
    .pass-stub-name {
      font-family: var(--font-mono); font-size: 0.56rem;
      letter-spacing: 0.1em; color: rgba(18, 35, 59, 0.6);
    }
    .pass-mini { display: flex; gap: 0.9rem; }
    .pass-mini-cell { display: flex; flex-direction: column; }
    .pass-mini-cell small {
      font-family: var(--font-mono); font-size: 0.5rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(18, 35, 59, 0.5);
    }
    .pass-mini-cell strong { font-size: 0.95rem; }
    .pass-barcode {
      display: flex; align-items: stretch; gap: 1px;
      height: 52px; margin-top: auto; max-width: 100%;
    }
    .pass-barcode i { flex: 0 0 auto; background: var(--ink); }
    .pass-seq {
      font-family: var(--font-mono); font-size: 0.5rem;
      letter-spacing: 0.14em; color: rgba(18, 35, 59, 0.55);
    }

    @media (max-width: 520px) {
      .pass-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (prefers-reduced-motion: reduce) {
      .pass { opacity: 1; transform: none; transition: none; }
      .pass::after, .pass-fly-plane { animation: none; }
    }

    /* ─── Sunset sky — fixed layers behind the 3D canvas, scrubbed by scroll ── */
    #sky, .sky-layer, .sky-stars {
      position: fixed; inset: 0; pointer-events: none;
    }
    #sky { z-index: -1; }   /* above body bg, below #three-canvas (z 0) */
    .sky-layer { opacity: 0; will-change: opacity; }
    .sky-sunset {
      background: linear-gradient(180deg,
        #35406e 0%, #7d4a72 30%, #d96a5a 60%, #ffb35c 85%, #ffd9a0 100%);
    }
    .sky-night {
      background: linear-gradient(180deg, #060b1f 0%, #0d1633 55%, #1b2a52 100%);
    }
    .sky-stars {
      background-image:
        radial-gradient(1.2px 1.2px at 22px 34px,  rgba(255,255,255,0.95), transparent 60%),
        radial-gradient(1px   1px   at 118px 76px, rgba(255,255,255,0.7),  transparent 60%),
        radial-gradient(1.4px 1.4px at 187px 149px,rgba(255,255,255,0.85), transparent 60%),
        radial-gradient(1px   1px   at 66px 187px, rgba(255,255,255,0.6),  transparent 60%),
        radial-gradient(1.1px 1.1px at 205px 41px, rgba(255,255,255,0.8),  transparent 60%);
      background-size: 240px 240px;
    }
    .sky-stars--b {
      background-position: 120px 80px;
      animation: skyTwinkle 3.4s ease-in-out infinite alternate;
    }
    @keyframes skyTwinkle { from { opacity: 0.25; } to { opacity: 1; } }
    .sky-moon {
      position: absolute; top: 9%; right: 11%;
      width: 74px; height: 74px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #fdfbf4, #e8e4d5 60%, #cfcaba);
      box-shadow: 0 0 46px 10px rgba(255, 250, 230, 0.25);
    }
    @media (prefers-reduced-motion: reduce) {
      .sky-stars--b { animation: none; }
    }

    /* ─── Departure board — split-flap ─── */
    .dep-board {
      margin-top: 1.6rem;
      background: #0c1526;
      border-radius: 1rem;
      padding: 1rem 1.1rem 1.2rem;
      overflow-x: auto;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07),
                  0 24px 48px -24px rgba(6, 15, 32, 0.8);
      font-family: var(--font-mono);
    }
    .dep-head, .dep-row {
      display: grid;
      grid-template-columns: 5.5rem 1fr 8.5rem;
      gap: 1rem;
      align-items: center;
      min-width: 560px;
    }
    .dep-head {
      font-size: 0.55rem; letter-spacing: 0.28em; text-transform: uppercase;
      color: rgba(255, 255, 255, 0.4);
      padding: 0.3rem 0.2rem 0.6rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .dep-row {
      padding: 0.45rem 0.2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .dep-row:last-child { border-bottom: 0; }
    .dep-cell {
      font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em;
      color: #e8eefc; white-space: nowrap;
    }
    /* Each character becomes a little flap tile (spans injected by JS). */
    .dep-cell .flap {
      display: inline-block;
      min-width: 1ch; text-align: center;
      padding: 0.14em 0.06em;
      margin-right: 1.5px;
      border-radius: 2.5px;
      background: linear-gradient(180deg, #1d2c49 0%, #1d2c49 47%, #101d35 53%, #101d35 100%);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
    }
    .dep-status--ok   { color: #8fe14f; }
    .dep-status--now  { color: #ffb02e; }
    .dep-status--call { color: #ff5460; }
    .dep-row--final .dep-status .flap { animation: depBlink 1.1s steps(2, start) infinite; }
    @keyframes depBlink { to { opacity: 0.25; } }
    @media (prefers-reduced-motion: reduce) {
      .dep-row--final .dep-status .flap { animation: none; }
    }

    /* ─── Reverse recap wall — each tile carries that week's 3D hero ─── */
    .recap-wall {
      display: grid;
      grid-template-columns: repeat(5, 1fr);   /* 5 and 5 */
      gap: 0.8rem;
      margin-top: 1.6rem;
    }
    @media (max-width: 720px) {
      .recap-wall { grid-template-columns: repeat(2, 1fr); }
    }
    .recap-tile {
      display: flex; flex-direction: column; gap: 0.3rem;
      padding: 0.9rem 1.2rem 1.1rem;
      border-radius: 1rem;
      text-decoration: none;
      background: color-mix(in srgb, var(--tile) 9%, transparent);
      border: 1px solid color-mix(in srgb, var(--tile) 30%, transparent);
      border-left: 4px solid var(--tile);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .recap-canvas {
      width: 100%; height: 120px; display: block;
      margin-bottom: 0.4rem;
    }
    a.recap-tile:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px color-mix(in srgb, var(--tile) 25%, transparent);
    }
    .recap-tile.is-locked { opacity: 0.55; filter: grayscale(0.35); }
    .recap-num {
      font-family: var(--font-mono); font-weight: 700; font-size: 1.4rem;
      color: var(--tile); line-height: 1;
    }
    .recap-sub {
      font-size: 0.82rem; line-height: 1.35;
      color: rgba(20, 40, 70, 0.78);
    }

    /* FIFA-26 rainbow tile (week 09, matches its page theme) */
    .recap-tile--rainbow {
      background-image: linear-gradient(
        125deg,
        #6A2CB0, #1E5BE6, #12B6A6, #8CD612,
        #FFC200, #FF6A13, #E8112D, #FF3D9A, #6A2CB0
      );
      background-size: 300% 300%;
      border-color: rgba(255,255,255,0.4);
      border-left-color: #fff;
      animation: rainbowShift 9s ease-in-out infinite;
    }
    @keyframes rainbowShift {
      0%, 100% { background-position: 0% 50%; }
      50%      { background-position: 100% 50%; }
    }
    .recap-tile--rainbow .recap-num { color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.45); }
    .recap-tile--rainbow .recap-sub { color: rgba(255,255,255,0.92); text-shadow: 0 1px 6px rgba(0,0,0,0.4); }
    @media (prefers-reduced-motion: reduce) {
      .recap-tile--rainbow { animation: none; }
    }

    /* ─── Two-person letter ─── */
    .letter-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;
      margin-top: 1.6rem;
    }
    .letter {
      padding: 1.6rem;
      border-radius: 1.1rem;
      background: rgba(0, 188, 212, 0.06);
      border: 1px solid rgba(0, 188, 212, 0.2);
    }
    .letter-from {
      display: block; font-family: var(--font-mono);
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--week-accent); margin-bottom: 0.7rem;
    }
    .letter p { margin: 0; line-height: 1.6; }
    @media (max-width: 560px) {
      .letter-grid { grid-template-columns: 1fr; }
    }

    /* ─── 3D memory cloud ─── */
    .content-section--wide { text-align: center; }
    .content-section--wide p { margin-left: auto; margin-right: auto; }
    #memory-cloud {
      position: relative;
      width: 100%;
      height: 82vh;
      margin: 1rem 0 0;
      overflow: hidden;   /* clip the-end's stroke overshoot → no stray scrollbar */
    }
    #memory-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }
    .memory-hint {
      position: absolute;
      bottom: 1.4rem; left: 50%; transform: translateX(-50%);
      font-family: var(--font-mono); font-size: 0.62rem;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--week-primary); opacity: 0.6;
      pointer-events: none;
    }
    /* Hand-drawn "The End" — stroke draws in on the final scroll of the flythrough */
    .the-end {
      position: absolute; inset: 0; margin: auto;
      width: min(60vw, 520px); height: auto;
      pointer-events: none; opacity: 0;
      overflow: visible;
    }
    .the-end text {
      font-family: 'Brush Script MT', 'Segoe Script', cursive;
      font-size: 140px; font-style: italic;
      fill: var(--week-primary); fill-opacity: 0;
      stroke: var(--week-primary); stroke-width: 1.4;
      stroke-linejoin: round; stroke-linecap: round;
      stroke-dasharray: 2600; stroke-dashoffset: 2600;
      paint-order: stroke;
    }

  </style>

  <!-- The cloud is the last thing on the page: kill the content's trailing
       padding AND hide the week-nav footer, so the flythrough ends on "The
       End" with nothing sliding in underneath. -->
  <style is:global>
    .week-content:has(#memory-cloud) { padding-bottom: 0; }
    .week-footer { display: none; }
  </style>
</WeekLayout>
