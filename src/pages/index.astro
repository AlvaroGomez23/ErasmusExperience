---
import { weeks } from '../data/weeks';
import { PUBLISHED_WEEKS } from '../config/routes';
import '../styles/global.css';
import WeekStrip from '../components/WeekStrip.astro';
import Analytics from '@vercel/analytics/astro';

const isDark = (hex: string) => {
  const c = hex.replace('#', '');
  const r = parseInt(c.slice(0, 2), 16);
  const g = parseInt(c.slice(2, 4), 16);
  const b = parseInt(c.slice(4, 6), 16);
  return (0.299 * r + 0.587 * g + 0.114 * b) < 128;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/photos/Flag_of_Europe.svg.webp" />
    <meta name="description" content="Erasmus in Amarante, Portugal 2026 — Jose & Álvaro. 11 weeks, a thousand memories." />
    <title>Amarante Erasmus '26 — Jose & Álvaro</title>
    <style>
      :root {
        --week-primary: #88CE02;
        --week-bg: #f0f7e6;
      }
      body { background-color: #f8f5ee; }
    </style>
  </head>

  <body>
    <!-- NAV -->
    <nav class="site-nav">
      <div class="nav-bar">
        <span class="nav-home" style="cursor:default">Amarante '26</span>
        <span class="nav-week">Portugal</span>
        <div class="nav-names">
          <span>Jose</span>
          <a href="/party" class="sep party-secret">×</a>
          <span>Alvaro</span>
        </div>
      </div>
      <WeekStrip />
    </nav>

    <!-- THREE.JS CANVAS -->
    <canvas id="three-canvas" aria-hidden="true"></canvas>

    <!-- SITE HERO -->
    <section class="site-hero">
      <p class="site-tagline">Erasmus · Amarante · Portugal · 2026</p>
      <h1 class="site-title">
        AMARANTE
      </h1>
      <div class="site-meta">
        <div><strong>Jose & Álvaro</strong></div>
        <div>11 weeks</div>
        <div>Northern Portugal</div>
        <div>LAT: 41.5928° N</div>
        <div>LON: 8.0285° W</div>
        <div>Erasmus+</div>
      </div>
      <div class="scroll-hint" style="margin-top:2rem" aria-hidden="true">
        <span>Explore</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- COUNTDOWN -->
    <section class="countdown-section content-section" id="countdown">
      <span class="section-tag">The journey home</span>
      <h2 class="cd-title">Our time left for<br> <span>August&nbsp;1st</span></h2>
      <p class="cd-sub">We leave Portugal on July&nbsp;31 · 22:00 — home by the 1st.</p>

      <div class="cd-clock" data-clock>
        <div class="cd-unit"><span class="cd-num" data-days>00</span><span class="cd-lbl">days</span></div>
        <div class="cd-sep">:</div>
        <div class="cd-unit"><span class="cd-num" data-hrs>00</span><span class="cd-lbl">hours</span></div>
        <div class="cd-sep">:</div>
        <div class="cd-unit"><span class="cd-num" data-min>00</span><span class="cd-lbl">min</span></div>
        <div class="cd-sep">:</div>
        <div class="cd-unit"><span class="cd-num" data-sec>00</span><span class="cd-lbl">sec</span></div>
      </div>

      <div class="cd-done" data-done hidden>
        <span class="cd-done-icon">✈</span>
        <p class="cd-done-line">Home.</p>
        <p class="cd-done-sub">11 weeks, lived.</p>
      </div>

      <div class="cd-progress">
        <div class="cd-bar"><div class="cd-fill" data-fill><span class="cd-plane">✈</span></div></div>
        <div class="cd-progress-meta">
          <span class="cd-pct" data-pct>0%</span>
          <span>of the adventure lived</span>
        </div>
      </div>

      <div class="cd-stats">
        <div><strong data-weeks-done>0</strong><span>weeks lived</span></div>
        <div><strong data-weeks-left>11</strong><span>weeks left</span></div>
        <div><strong data-days-left>0</strong><span>days to go</span></div>
      </div>
    </section>

    <!-- WEEKS GRID -->
    <section class="weeks-section">
      <div class="weeks-section-header content-section">
        <span class="section-tag">The journey</span>
        <h2>11 weeks in Portugal</h2>
      </div>

      <div class="weeks-grid">
        {
          weeks.filter((w) => PUBLISHED_WEEKS.includes(w.week)).map((w, i) => (
            <a
              href={`/${w.slug}`}
              class={`week-card${isDark(w.bgColor) ? ' week-card--dark' : ''}${w.week === 9 ? ' week-card--rainbow' : ''}`}
              style={`background-color:${w.bgColor}; border: 2px solid ${w.primaryColor}20;`}
              data-index={i}
            >
              <span class="card-num">{w.dates}</span>
              <div>
                <div
                  class="card-week-title"
                  style={`color:${w.primaryColor}`}
                >
                  {w.title}
                </div>
                <div class="card-dates">{w.subtitle}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about-section">
      <div class="about-inner content-section" style="max-width:900px;margin:0 auto;">
        <div>
          <div class="about-name">
            Jose<span>&</span>Alvaro
          </div>
        </div>
        <div class="about-text">
          <p>
            Two brothers, a small city in northern Portugal, and eleven weeks to
            explore it all. This is our Erasmus diary in Amarante.
          </p>
          <p>
            Each week has its own story: places, people, food, adventures
            and the moments we never planned.
          </p>
        </div>
      </div>
    </section>

    <script>
      import '../scripts/three-index.ts';
    </script>
    <script>
      import '../scripts/cursor.ts';
    </script>
    <script>
      import '../scripts/party-egg.ts';
    </script>
    <script>
      const nav = document.querySelector('.site-nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('is-scrolled', window.scrollY > 20);
      }, { passive: true });
    </script>
    <script>
      import gsap from 'gsap';

      // ── COUNTDOWN to departure (Portugal WEST = UTC+1) ──
      const START  = new Date('2026-05-20T00:00:00+01:00').getTime(); // week 01 begins
      const DEPART = new Date('2026-07-31T22:00:00+01:00').getTime(); // wheels up
      const TOTAL_WEEKS = 11;
      const DAY = 86400000;
      const WEEK = 7 * DAY;

      // Preview the landing before we actually land.
      //   /?finished     → jump straight to the landed state
      //   /?finished=15  → land 15s from now, so you watch it arrive live
      // Dev-only: import.meta.env.DEV compiles to false in the build, so the
      // flag is dead code on the deployed site.
      const previewArg = import.meta.env.DEV
        ? new URLSearchParams(location.search).get('finished')
        : null;
      // Fake departure = now + N seconds, and fake start = 100s before that, so
      // the bar is at 90% with 10s left and visibly climbs the rest of the way.
      const previewDepart = Date.now() + (Number(previewArg) || 0) * 1000;
      const depart = previewArg === null ? DEPART : previewDepart;
      const start  = previewArg === null ? START  : previewDepart - 100000;

      const $ = (sel: string) => document.querySelector<HTMLElement>(sel);
      const section = $('#countdown');
      const elClock = $('[data-clock]');
      const elDone  = $('[data-done]');
      const elSub   = $('.cd-sub');
      const elMeta  = document.querySelector<HTMLElement>('.cd-progress-meta span:last-child');
      const elDays  = $('[data-days]');
      const elHrs   = $('[data-hrs]');
      const elMin   = $('[data-min]');
      const elSec   = $('[data-sec]');
      const elFill  = $('[data-fill]');
      const elPct   = $('[data-pct]');
      const elWDone = $('[data-weeks-done]');
      const elWLeft = $('[data-weeks-left]');
      const elDLeft = $('[data-days-left]');
      const pad = (n: number) => String(n).padStart(2, '0');

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let timer = 0;
      let done = false;

      function setLanded() {
        if (elSub)  elSub.textContent  = 'July 31 · 22:00 — we made it home.';
        if (elMeta) elMeta.textContent = 'adventure complete';
        if (elFill) elFill.style.width = '100%';
        if (elPct)  elPct.textContent  = '100%';
        if (elWDone) elWDone.textContent = String(TOTAL_WEEKS);
        if (elWLeft) elWLeft.textContent = '0';
        if (elDLeft) elDLeft.textContent = '0';
      }

      // Paper bits thrown from the middle of the card: burst out, then fall.
      function confetti() {
        const COLORS = ['#88CE02', '#4CAF50', '#FFD700', '#2e7d12'];
        for (let i = 0; i < 26; i++) {
          const bit = document.createElement('span');
          bit.className = 'cd-confetti';
          bit.style.background = COLORS[i % COLORS.length];
          section?.appendChild(bit);
          gsap.timeline({ onComplete: () => bit.remove() })
            .fromTo(bit,
              { x: 0, y: 0, opacity: 1, scale: gsap.utils.random(0.6, 1.3) },
              { x: gsap.utils.random(-280, 280), y: gsap.utils.random(-210, -90),
                rotation: gsap.utils.random(-180, 180), duration: 0.55, ease: 'power2.out' })
            .to(bit, { y: '+=360', rotation: `+=${gsap.utils.random(-220, 220)}`,
                       duration: 1.25, ease: 'power1.in' }, '>-0.1')
            .to(bit, { opacity: 0, duration: 0.45 }, '<0.75');
        }
      }

      function finish() {
        if (done) return;
        done = true;
        clearInterval(timer);
        setLanded();

        if (reduce) {
          elClock?.setAttribute('hidden', '');
          elDone?.removeAttribute('hidden');
          section?.classList.add('is-complete');
          return;
        }

        // is-complete lands last, on purpose: it starts the idle bob and the
        // glow pulse, and those CSS animations would fight the entrance
        // tweens for the same transform if they were running during it.
        gsap.timeline({ onComplete: () => section?.classList.add('is-complete') })
          // nothing left to count — the clock collapses
          .to('.cd-unit', { y: -14, opacity: 0, scale: 0.92, duration: 0.35,
                            stagger: 0.05, ease: 'power2.in' })
          .add(() => {
            elClock?.setAttribute('hidden', '');
            elDone?.removeAttribute('hidden');
            // unhiding alone would flash it at full opacity until its own
            // tween starts, so park it invisible for those few frames
            gsap.set(elDone, { opacity: 0 });
          }, 0.5)
          // the little plane on the bar takes off ...
          .fromTo('.cd-plane', { yPercent: -50, y: 0, rotation: 0 },
            { y: -70, x: 50, rotation: -25, opacity: 0, duration: 0.6, ease: 'power2.in' }, 0.5)
          // ... and comes back down as the big one
          .fromTo(elDone, { opacity: 0, scale: 0.7 },
            { opacity: 1, scale: 1, duration: 0.6, ease: 'back.out(1.7)' }, 0.75)
          .fromTo('.cd-done-icon', { y: -90, rotation: 14, opacity: 0 },
            { y: 0, rotation: 0, opacity: 1, duration: 0.9, ease: 'bounce.out' }, 0.8)
          .add(confetti, 1.1)
          .fromTo('.cd-done-line', { y: 24, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }, 1.15)
          .fromTo('.cd-done-sub', { y: 14, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.4 }, 1.3);
      }

      function update() {
        const now = Date.now();
        const left = Math.max(0, depart - now);

        if (left <= 0) { finish(); return; }

        const d = Math.floor(left / DAY);
        const h = Math.floor((left % DAY) / 3600000);
        const m = Math.floor((left % 3600000) / 60000);
        const s = Math.floor((left % 60000) / 1000);
        if (elDays) elDays.textContent = pad(d);
        if (elHrs)  elHrs.textContent  = pad(h);
        if (elMin)  elMin.textContent  = pad(m);
        if (elSec)  elSec.textContent  = pad(s);

        const prog = Math.min(1, Math.max(0, (now - start) / (depart - start)));
        const pct = Math.floor(prog * 100);
        if (elFill) elFill.style.width = (prog * 100) + '%';
        if (elPct)  elPct.textContent  = pct + '%';

        // weeks counted off the Mon–Sun grid, with a live fractional part
        const lived = Math.min(TOTAL_WEEKS, Math.max(0, (now - START) / WEEK));
        if (elWDone) elWDone.textContent = lived.toFixed(1);            // weeks lived
        if (elWLeft) elWLeft.textContent = (left / WEEK).toFixed(1);    // weeks still ahead
        if (elDLeft) elDLeft.textContent = (left / DAY).toFixed(1);
      }

      update();
      // guard: if that first update already landed us, finish() cleared a timer
      // that did not exist yet — starting one now would tick forever doing nothing
      if (!done) timer = window.setInterval(update, 1000);
    </script>
    <Analytics />

    <style>
      .countdown-section {
        position: relative; z-index: 1;
        max-width: 760px; margin: 4rem auto; padding: 3.5rem 2.5rem;
        text-align: center;
        background: rgba(248, 245, 238, 0.72);
        backdrop-filter: blur(14px) saturate(1.1);
        -webkit-backdrop-filter: blur(14px) saturate(1.1);
        border: 1px solid rgba(136,206,2,0.22);
        border-radius: 1.5rem;
        box-shadow: 0 18px 50px rgba(30,50,10,0.12);
      }
      .cd-title {
        font-size: clamp(1.8rem, 4.5vw, 2.8rem); font-weight: 600;
        line-height: 1.15; margin: 0.8rem 0 0.5rem; color: #1f2a12;
      }
      .cd-title span {
        background: linear-gradient(120deg, #88CE02, #4CAF50);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .cd-sub {
        font-family: var(--font-mono); font-size: 0.8rem;
        letter-spacing: 0.04em; color: rgba(40,60,20,0.7);
        margin: 0 auto 2.5rem; max-width: 38ch; text-align: center;
      }

      .cd-clock {
        display: flex; align-items: flex-start; justify-content: center;
        gap: 0.6rem; margin-bottom: 2.6rem;
      }
      .cd-unit {
        display: flex; flex-direction: column; align-items: center;
        min-width: 78px;
        background: rgba(136,206,2,0.08);
        border: 1px solid rgba(136,206,2,0.28);
        border-radius: 0.9rem; padding: 1rem 0.6rem;
      }
      .cd-num {
        font-family: var(--font-mono); font-weight: 700;
        font-size: clamp(1.8rem, 5vw, 2.8rem); line-height: 1;
        color: #2e7d12; font-variant-numeric: tabular-nums;
      }
      .cd-lbl {
        font-family: var(--font-mono); font-size: 0.6rem;
        letter-spacing: 0.22em; text-transform: uppercase;
        color: rgba(40,60,20,0.6); margin-top: 0.55rem;
      }
      .cd-sep {
        font-size: clamp(1.4rem, 4vw, 2.2rem); font-weight: 700;
        color: rgba(136,206,2,0.5); align-self: center; margin-top: -0.6rem;
      }
      @media (max-width: 480px) {
        .cd-unit { min-width: 0; flex: 1; padding: 0.7rem 0.3rem; }
        .cd-sep { display: none; }
      }

      .cd-progress { margin-bottom: 2.4rem; }
      .cd-bar {
        position: relative; height: 12px; border-radius: 999px;
        background: rgba(40,60,20,0.1); overflow: visible;
      }
      .cd-fill {
        position: absolute; inset: 0 auto 0 0; width: 0%;
        border-radius: 999px;
        background: linear-gradient(90deg, #88CE02, #4CAF50);
        transition: width 0.8s ease;
      }
      .cd-plane {
        position: absolute; right: -16px; top: 50%;
        transform: translateY(-50%); font-size: 2rem;
        line-height: 1; display: block;
        filter: drop-shadow(0 2px 4px rgba(40,80,0,0.4));
      }
      .cd-progress-meta {
        display: flex; align-items: baseline; justify-content: center;
        gap: 0.5rem; margin-top: 1rem;
      }
      .cd-pct {
        font-family: var(--font-mono); font-weight: 700;
        font-size: 1.4rem; color: #2e7d12;
      }
      .cd-progress-meta span:last-child {
        font-family: var(--font-mono); font-size: 0.72rem;
        letter-spacing: 0.05em; color: rgba(40,60,20,0.65);
      }

      .cd-stats {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 1rem; max-width: 460px; margin: 0 auto;
      }
      .cd-stats div { display: flex; flex-direction: column; align-items: center; }
      .cd-stats strong {
        font-family: var(--font-mono); font-size: 1.5rem;
        color: #1f2a12; font-variant-numeric: tabular-nums;
      }
      .cd-stats span {
        font-family: var(--font-mono); font-size: 0.62rem;
        letter-spacing: 0.16em; text-transform: uppercase;
        color: rgba(40,60,20,0.6); margin-top: 0.3rem;
      }

      /* ── FINISHED STATE ── */
      .cd-clock[hidden], .cd-done[hidden] { display: none; }
      .cd-confetti {
        position: absolute; top: 42%; left: 50%;
        width: 8px; height: 14px; border-radius: 2px;
        pointer-events: none; z-index: 3;
      }
      .cd-done {
        display: flex; flex-direction: column; align-items: center;
        margin-bottom: 2.6rem;
      }
      .cd-done-icon {
        font-size: clamp(2.6rem, 7vw, 3.6rem); line-height: 1;
        filter: drop-shadow(0 3px 6px rgba(40,80,0,0.3));
      }
      /* Only once the landing tweens are done — a running CSS animation beats
         inline styles, so this would hijack the transform mid-entrance. */
      .is-complete .cd-done-icon {
        animation: cd-land 3s ease-in-out infinite;
      }
      @keyframes cd-land {
        0%, 100% { transform: translateY(0) rotate(-4deg); }
        50%      { transform: translateY(-8px) rotate(4deg); }
      }
      .cd-done-line {
        font-size: clamp(2rem, 6vw, 3rem); font-weight: 700;
        margin: 0.6rem 0 0; color: #2e7d12; letter-spacing: -0.01em;
      }
      .cd-done-sub {
        font-family: var(--font-mono); font-size: 0.85rem;
        letter-spacing: 0.05em; color: rgba(40,60,20,0.7); margin: 0.4rem 0 0;
      }
      .countdown-section.is-complete {
        border-color: rgba(136,206,2,0.5);
        animation: cd-celebrate 2.4s ease-in-out infinite;
      }
      @keyframes cd-celebrate {
        0%, 100% { box-shadow: 0 18px 50px rgba(30,50,10,0.12); }
        50%      { box-shadow: 0 18px 60px rgba(136,206,2,0.35); }
      }

      /* ── FIFA-26 RAINBOW CARD (week 09, matches its page theme) ── */
      .week-card--rainbow {
        background-image: linear-gradient(
          125deg,
          #6A2CB0, #1E5BE6, #12B6A6, #8CD612,
          #FFC200, #FF6A13, #E8112D, #FF3D9A, #6A2CB0
        );
        background-size: 300% 300%;
        border-color: rgba(255,255,255,0.4) !important;
        animation: rainbowShift 9s ease-in-out infinite;
      }
      @keyframes rainbowShift {
        0%, 100% { background-position: 0% 50%; }
        50%      { background-position: 100% 50%; }
      }
      .week-card--rainbow .card-num,
      .week-card--rainbow .card-dates {
        color: #fff;
        text-shadow: 0 1px 6px rgba(0,0,0,0.4);
      }
      .week-card--rainbow .card-week-title {
        color: #fff !important;
        text-shadow: 0 2px 10px rgba(0,0,0,0.45);
      }
      @media (prefers-reduced-motion: reduce) {
        .week-card--rainbow { animation: none; }
      }
    </style>
  </body>
</html>
