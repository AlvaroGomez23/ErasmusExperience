---
import WeekLayout from '../layouts/WeekLayout.astro';
import { PUBLISHED_WEEKS } from '../config/routes';
if (!PUBLISHED_WEEKS.includes(10)) return Astro.redirect('/');

const flight = [
  {
    name: 'White',
    pt: 'Branco',
    wine: '#C9A050',
    serve: 'Chilled, 8 °C',
    note: 'Fresh and citrusy, with a dry finish. It\'s quite different from the rich, sweet style most people expect from port, and is often served over ice with tonic and a slice of lemon.',
    pair: 'Citrus, green apple, honey',
  },
  {
    name: 'Ruby',
    pt: 'Ruby',
    wine: '#7A0C2E',
    serve: 'Cool, 14 °C',
    note: 'A young, fruity port with deep red colour and fresh berry flavours. It\'s aged in large vats to preserve its vibrant character rather than developing nutty notes.',
    pair: 'Blackberry, cherry, plum',
  },
  {
    name: 'Tawny',
    pt: 'Tawny',
    wine: '#A8481B',
    serve: 'Cool, 14 °C',
    note: 'Aged in oak for around ten years, giving it flavours of caramel, toasted nuts and dried fruit. The extended ageing also gives it its distinctive amber colour.',
    pair: 'Caramel, walnut, dried fig',
  },
];
---

<WeekLayout
  week={10}
  title="10"
  subtitle="The wrong side of the river"
  dates="20 — 26 JUL"
  primaryColor="#5E2333"
  accentColor="#7E8C4F"
  bgColor="#E7E3D5"
  prevSlug="week-09"
  prevTitle="Week 09"
  nextSlug="week-11"
  nextTitle="Week 11"
  modelPath="skip"
  glassContent
>
  <!-- ── GAIA ── -->
  <section class="content-section">
    <span class="section-tag">Vila Nova de Gaia</span>
    <h2>The wine crosses<br/>the river</h2>
      <p>
        Port isn't actually made in Porto. It's produced about eighty kilometres up the Douro Valley, where the vineyards cling to steep schist terraces that are still worked by hand. Once the wine is made, it's brought downriver to Vila Nova de Gaia, across the river from Porto, where it's traditionally aged in cool, dark lodges.
      </p>

      <p>
        That location wasn't chosen by accident. Gaia faces north, stays cooler, and catches the damp Atlantic air, giving the wine the steady conditions it needs to mature. On the Porto side of the river, the warmer temperatures would have made ageing much more difficult.
      </p>

      <p>
        At the end of this week, we'll cross the Douro and see that history for ourselves.
      </p>
  </section>

  <!-- ── THE RITUAL ── -->
  <section class="content-section">
    <span class="section-tag">The ritual</span>
    <h2>How to taste it<br/>without looking lost</h2>
    <p>
      There are four simple steps to tasting port properly. They're easy enough, and they'll help you get much more out of the experience.
    </p>
    <ol class="ritual">
      <li>
        <h3>Look</h3>
        <p>Hold the glass against a white background and check the colour. Younger ports tend to have deep purple tones, while older ports become lighter, with amber or tawny colours after spending years in wood.</p>
      </li>
      <li>
        <h3>Swirl</h3>
        <p>Give the glass a gentle swirl to release the aromas. You'll also notice the "legs" running down the inside of the glass. Slower, thicker legs usually mean higher alcohol and sugar.</p>
      </li>
      <li>
        <h3>Smell</h3>
        <p>Bring the glass to your nose and take a couple of short sniffs. Most of what we think of as flavour actually comes from smell, which is why this step is so important.</p>
      </li>
      <li>
        <h3>Sip</h3>
        <p>Take a small sip and let it sit for a moment. Port is usually around 20% alcohol because fermentation is stopped early by adding grape spirit. That leaves some of the natural sugar behind, giving port its sweetness and higher alcohol content.</p>
      </li>
    </ol>
  </section>

  <!-- ── THE FLIGHT ── -->
  <section class="content-section flight-section">
    <span class="section-tag">The flight</span>
    <h2>Three glasses,<br/>three flavours</h2>
    <p>
      A tasting runs in one direction: pale and cold at the start, dark and sweet at the
      end, because anything heavy ruins whatever follows it. This is the order we're
      ordering in.
    </p>

    <div class="flight-stage">
      <div class="flight">
        {flight.map((w, i) => (
          <article class="wine-card" style={`--wine:${w.wine}`}>
            <span class="wine-order">{String(i + 1).padStart(2, '0')}</span>
            <h3>{w.name}</h3>
            <span class="wine-pt">{w.pt}</span>
            <span class="wine-serve">{w.serve}</span>
            <p>{w.note}</p>
            <span class="wine-pair">{w.pair}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PHOTOS ── -->
  <section class="content-section">
    <span class="section-tag">Photos</span>
    <h2>The week in images</h2>
    <div class="photo-grid">
      <div class="photo-item"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week10/week10-07.webp" loading="lazy" decoding="async" alt="Photo 1"></div>
      <div class="photo-item"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week10/week10-02.webp" loading="lazy" decoding="async" alt="Photo 2"></div>
      <div class="photo-item"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week10/week10-03.webp" loading="lazy" decoding="async" alt="Photo 3"></div>
      <div class="photo-item"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week10/week10-04.webp" loading="lazy" decoding="async" alt="Photo 4"></div>
      <div class="photo-item"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week10/week10-05.webp" loading="lazy" decoding="async" alt="Photo 5"></div>
      <div class="photo-item"><img src="https://uuphxemcxhlezcvehagp.supabase.co/storage/v1/object/public/Photos/week10/week10-06.webp" loading="lazy" decoding="async" alt="Photo 6"></div>
    </div>
  </section>

  <script>
    import '../scripts/three-week-10.ts';
  </script>

  <!-- Xisto palette: schist ground, bordeaux type, vine accent -->
  <style is:global>
    /* Warm the glass cards toward the schist ground (defaults are pure white).
       Stain-aware: once the flood submerges it, every section card takes a
       light bordeaux wash and a wine outline (--stain driven by GSAP). */
    .week-content--glass .content-section {
      background: color-mix(in srgb, #5E2333 calc(var(--stain, 0) * 16%), rgba(251, 249, 243, 0.86));
      border: 1.5px solid color-mix(in srgb, #5E2333 calc(var(--stain, 0) * 75%), rgba(94, 35, 51, 0.1));
    }
    .hero-subtitle,
    .hero-dates,
    .scroll-hint { color: #2A2320; }
    .site-nav {
      background:   rgba(231, 227, 213, 0.55);
      border-color: rgba(94, 35, 51, 0.18);
    }
    .site-nav.is-scrolled {
      background:   rgba(231, 227, 213, 0.9);
      border-color: rgba(94, 35, 51, 0.35);
    }
    .week-footer {
      background: #E7E3D5;
      border-top-color: rgba(94, 35, 51, 0.18);
    }
    .week-nav-link:hover .nav-link-title { color: #5E2333; }
  </style>

  <style>
    /* Registered so the browser can interpolate the stain instead of snapping. */
    @property --stain {
      syntax: '<number>';
      initial-value: 0;
      inherits: false;
    }

    .content-section h2 { color: #2A2320; }

    /* ── RITUAL (numbered: it's a real sequence, you can't smell before you swirl) ── */
    .ritual {
      list-style: none;
      padding: 0;
      margin: 2.5rem 0 0;
      counter-reset: step;
      display: grid;
      gap: 1.6rem;
    }
    .ritual li {
      counter-increment: step;
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: 0.4rem 1rem;
      align-items: baseline;
    }
    .ritual li::before {
      content: counter(step, decimal-leading-zero);
      grid-row: span 2;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      color: #7E8C4F;
      padding-top: 0.35rem;
    }
    .ritual h3 {
      font-size: 1.3rem;
      font-weight: 700;
      color: #5E2333;
      margin: 0;
    }
    .ritual p { margin: 0; }

    /* ── THE FLOOD ──
       The wine itself is a fullscreen WebGL canvas built at runtime by
       three-week-10.ts (rises from the bottom, holds, drains). Only the
       stain variables live in CSS. */
    .flight-stage {
      margin-top: 2.5rem;
    }

    /* ── WINE CARDS ── */
    .flight {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1rem;
    }

    .wine-card {
      --stain: 0;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1.6rem 1.4rem;
      border-radius: 1.2rem;
      background: color-mix(in srgb, var(--wine) calc(var(--stain) * 26%), #FBF9F3);
      border: 2px solid color-mix(in srgb, var(--wine) calc(var(--stain) * 100%), rgba(42, 35, 32, 0.12));
    }

    .wine-order {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      color: color-mix(in srgb, var(--wine) calc(var(--stain) * 100%), rgba(42, 35, 32, 0.4));
    }

    .wine-card h3 {
      font-size: 1.5rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 1;
      margin: 0;
      color: color-mix(in srgb, var(--wine) calc(var(--stain) * 100%), #2A2320);
    }

    .wine-pt {
      font-size: 0.82rem;
      font-style: italic;
      opacity: 0.5;
    }

    .wine-serve {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #7E8C4F;
      margin-top: 0.3rem;
    }

    .wine-card p {
      font-size: 0.92rem;
      line-height: 1.6;
      opacity: 0.7;
      margin: 0.4rem 0 0;
    }

    .wine-pair {
      margin-top: auto;
      padding-top: 0.9rem;
      font-size: 0.78rem;
      letter-spacing: 0.02em;
      color: color-mix(in srgb, var(--wine) calc(var(--stain) * 85%), rgba(42, 35, 32, 0.55));
    }

    /* ── PHOTOS ── */
    .photo-item {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s;
    }
    .photo-item:hover {
      transform: scale(1.04);
      box-shadow: 0 14px 36px rgba(94, 35, 51, 0.18);
    }
  </style>
</WeekLayout>
